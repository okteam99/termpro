{
  "name": "termpro",
  "productName": "TermPro",
  "version": "0.3.39",
  "description": "Terminal-first workbench for running many AI coding agents in parallel — agent-agnostic, macOS.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "make:dev": "TERMPRO_DEV_BUILD=1 electron-forge make"
  },
  "keywords": [
    "terminal",
    "terminal-emulator",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "git-worktree",
    "developer-tools",
    "xterm",
    "monaco-editor",
    "electron",
    "tui",
    "macos"
  ],
  "author": {
    "name": "lA",
    "email": "1@3.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "42.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.10",
    "electron-squirrel-startup": "^1.0.1",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  }
